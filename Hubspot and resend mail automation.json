    {
      "parameters": {
        "jsCode": "const contacts = $input.all();\n\nconst results = contacts.map(c => {\n  const props = c.json.properties || {};\n  const identities = c.json[\"identity-profiles\"]?.[0]?.identities || [];\n\n  const emailObj = identities.find(i => i.type === \"EMAIL\");\n\n  return {\n    json: {\n      firstname: props.firstname?.value || \"\",\n      lastname: props.lastname?.value || \"\",\n      name: `${props.firstname?.value || \"\"} ${props.lastname?.value || \"\"}`.trim(),\n      email: emailObj?.value || \"\",\n      company: props.company?.value || \"\"\n    }\n  };\n});\n\nreturn results;"
      },
